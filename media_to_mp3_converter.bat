powershell -NoProfile -Command "$b = ((Get-Content -Raw $env:B64FILE) -replace '[\r\n]',''); [IO.File]::WriteAllBytes($env:PSFILE,[Convert]::FromBase64String($b))"

del "%B64FILE%" >nul 2>nul

if not exist "%PSFILE%" (
    echo ERROR: Failed to prepare the converter script.
    pause
    exit /b 1
)

if "%~1"=="" (
    powershell -NoProfile -ExecutionPolicy Bypass -File "%PSFILE%" -SourceDir "%SOURCE_DIR_ARG%"
) else (
    powershell -NoProfile -ExecutionPolicy Bypass -File "%PSFILE%" -SourceDir "%SOURCE_DIR_ARG%" -DroppedItems %*
)

set "PSEXIT=%ERRORLEVEL%"
del "%PSFILE%" >nul 2>nul

if not "%PSEXIT%"=="0" (
    echo.
    echo The converter exited with an error (code %PSEXIT%^).
    pause
)
